<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
    
         本队（479 龙芯队）改动：
         
    nuttx:
        +arch/loongarch/
        +boards/loongarch/
        +libs/libc/machine/loongarch/
        libs/libxx/libcxx/libcxx/src/atomic.cpp
    
    apps:
    	+examples/ls_driver_test/
    	+examples/ls_lvgl/
    	+system/ls2k0300_power/
    
    packages/ai_agent:
    	+src/tools/tool_2k0300.*
    	+src/voice/
    	+agent_skills/board-control.md
    	src/llm/
    	src/core/
    
    vendor:
    	+loongson/
         
          本仓库其余不需要的软连接均已删除，详细改动见README.md
          
  -->
  <remote name="my_github" fetch="https://github.com/lingluan9/" />
  <include name="openvela.xml"/>

  <project path="contest2026_479_longxindui" name="contest2026_479_longxindui">
  </project>
  
  <remove-project name="nuttx" />
  <project path="nuttx" name="nuttx" remote="my_github" revision="dev-ls" >
  <linkfile src="tools/build.sh" dest="build.sh"/>
  </project>
  
  <remove-project name="nuttx_libs_libxx_libcxx" />
  <project path="nuttx/libs/libxx/libcxx/libcxx" name="nuttx_libs_libxx_libcxx" remote="my_github" revision="dev-ls" />
  
  <remove-project name="nuttx-apps" />
  <project path="apps" name="nuttx-apps" remote="my_github" revision="dev-ls" />
  
  <remove-project name="vendor" />
  <project path="vendor" name="vendor" remote="my_github" revision="dev-ls" />
  
  <remove-project name="packages_ai_agent" />
  <project path="packages/ai_agent" name="packages_ai_agent" remote="my_github" revision="dev-ls2" />
</manifest>
